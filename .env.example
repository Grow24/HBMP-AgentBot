# =============================================================================
# HBMP AgentBot — standalone environment
# Copy this file:  cp .env.example .env
# Then fill in secrets and your public URL.
# =============================================================================

# --- Server (this app owns the whole origin; it is NOT under /HBMP_AgentBot) ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3080

# google first so a new chat works without creating an agent
ENDPOINTS=google,agents
GOOGLE_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Frontend Vite base path. Leave as / when this is its own site.
# Parent website only sets AGENTBOT_BASE=/HBMP_AgentBot/ when embedding.
AGENTBOT_BASE=/

# Public URLs of THIS app (no /HBMP_AgentBot suffix)
# Local:     http://localhost:3080
# Zeabur:    ${ZEABUR_WEB_URL}  (set both DOMAIN_* to your Zeabur domain)
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# --- Database ---
# Local Mongo: mongodb://127.0.0.1:27017/LibreChat
# Docker Compose: mongodb://mongodb:27017/LibreChat
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

# --- Search (optional; app still runs without it) ---
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=changeMe_generate_with_openssl_rand_hex_16
MEILI_NO_ANALYTICS=true

# --- RAG / file search (optional; enable with docker compose --profile rag) ---
# RAG_PORT=8000
# RAG_API_URL=http://127.0.0.1:8000

# --- Secrets (REQUIRED in production — generate unique values) ---
# openssl rand -hex 32
SESSION_SECRET=replace_with_openssl_rand_hex_32
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32
# openssl rand -hex 32  /  openssl rand -hex 16
CREDS_KEY=replace_with_openssl_rand_hex_32
CREDS_IV=replace_with_openssl_rand_hex_16

# --- Auth ---
ALLOW_REGISTRATION=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
TRUST_PROXY=1

# Conversation search (Meilisearch). Leave false on Zeabur unless you add Meili.
SEARCH=false

# --- AI providers (at least one key required) ---
GOOGLE_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Docker host user (optional; only if you bind-mount and hit permission errors) ---
# UID=1000
# GID=1000
